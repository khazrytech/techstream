datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String?
  plan      String   @default("STANDARD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Channel {
  id        String   @id @default(uuid())
  name      String
  streamUrl String
  logoUrl   String?
  category  String
  quality   String   @default("HD")
  isLive    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Report {
  id        String   @id @default(uuid())
  channelId String
  issueType String
  comment   String?
  createdAt DateTime @default(now())
}
